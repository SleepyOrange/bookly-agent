ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the default model
# BOOKLY_MODEL=claude-sonnet-5

# Optional: order/FAQ backend transport + resilience (see app/store.py)
# BOOKLY_TRANSPORT=rest              # rest | mcp
# BOOKLY_EXTERNAL_API_URL=http://127.0.0.1:8100
# BOOKLY_MCP_SERVER_URL=http://127.0.0.1:8200/mcp
# BOOKLY_MCP_API_KEY=                # only needed against the hosted (API Gateway) MCP server
# BOOKLY_ENABLE_FALLBACK=true        # shared by app/store.py and app/salesforce.py

# Optional: real Salesforce Case escalation (see app/salesforce.py)
# Defaults to the in-memory mock even if these are set -- BOOKLY_SALESFORCE_MODE
# must be set to "real" explicitly to create real Cases.
# BOOKLY_SALESFORCE_MODE=mock        # mock | real
# SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com
# SALESFORCE_CLIENT_ID=              # Connected App Consumer Key
# SALESFORCE_CLIENT_SECRET=          # Connected App Consumer Secret
# SALESFORCE_API_VERSION=v61.0
